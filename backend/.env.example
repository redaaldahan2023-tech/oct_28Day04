PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (default medium)
AGENT_EFFORT=medium
# Comma-separated list of allowed frontend origins, or * for any
CORS_ORIGIN=http://localhost:5173
# Long random string used to sign login tokens (required)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Default admin created by `npm run migrate` if missing (defaults: admin@admin.com / 123456789).
# The default password is well known: set ADMIN_PASSWORD before migrating a deployed database.
# ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=
# Defaults to off for localhost URLs and on otherwise
# DATABASE_SSL=false
